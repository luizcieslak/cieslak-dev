---
import fs from 'node:fs'
import path from 'node:path'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

interface Props {
	defaultImage?: string
	defaultAlt?: string
}

const {
	defaultImage = '/lofi-radio/glow-demo/Well Known Place.jpg',
	defaultAlt = 'Ambient glow sandbox preview',
} = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Build-time directory read (Node, not the browser): list every cover in
// public/lofi-radio/glow-demo/ so dropping a new file in is all it takes to add
// it to the Randomize rotation — no code change. public/ isn't seen by
// import.meta.glob, so fs.readdirSync is the way.
const GLOW_DEMO_DIR = 'lofi-radio/glow-demo'
const IMAGE_RE = /\.(png|jpe?g|webp|avif|gif)$/i
let demoImages: string[] = []
try {
	demoImages = fs
		.readdirSync(path.join(process.cwd(), 'public', GLOW_DEMO_DIR))
		.filter(name => IMAGE_RE.test(name))
		.sort()
		.map(name => `/${GLOW_DEMO_DIR}/${name}`)
} catch {
	demoImages = []
}
---

<figure
	class='ambient-glow-sandbox not-prose my-10 rounded-lg border border-main bg-muted/30 p-4'
	data-demo-images={JSON.stringify(demoImages)}
	data-label-enable={t('glow.pulse.enable')}
	data-label-play={t('glow.pulse.play')}
	data-label-pause={t('glow.pulse.pause')}
	data-label-connecting={t('glow.pulse.connecting')}
	data-label-pulsing-to={t('glow.pulse.pulsingTo')}
	data-label-paused={t('glow.pulse.paused')}
	data-label-blocked={t('glow.pulse.blocked')}
	data-label-unsupported={t('glow.pulse.unsupported')}
	data-label-off={t('glow.pulse.off')}
	data-label-amount={t('glow.pulse.amount')}
>
	<div
		class='ambient-glow-sandbox-stage relative mx-auto flex aspect-square w-full max-w-md items-center justify-center overflow-visible'
	>
		<img
			class='ambient-glow-sandbox-img relative z-10 block w-auto h-[200px] md:h-[300px] rounded-md object-cover shadow-md'
			src={defaultImage}
			alt={defaultAlt}
			crossorigin='anonymous'
		/>
	</div>

	<div class='ambient-glow-sandbox-pulse mt-5 grid gap-2 rounded-md border border-main p-3 text-sm'>
		<p class='font-medium'>{t('glow.pulse.title')}</p>
		<p class='text-xs opacity-70'>{t('glow.pulse.hint')}</p>
		<div class='flex flex-wrap items-center gap-x-3 gap-y-2'>
			<button
				type='button'
				class='ambient-glow-sandbox-pulse-toggle rounded-md border border-main px-3 py-1.5 font-medium opacity-90 transition-opacity hover:opacity-100 disabled:opacity-50'
			>
				{t('glow.pulse.enable')}
			</button>
			<span class='ambient-glow-sandbox-pulse-status min-w-0 flex-1 text-xs opacity-70' aria-live='polite'
			></span>
		</div>
		<canvas class='ambient-glow-sandbox-spectrum hidden h-12 w-full' aria-hidden='true'></canvas>
		<div class='ambient-glow-sandbox-pulse-controls grid gap-x-2'>
			<!-- pulse amount slider; see <script> below -->
		</div>
	</div>

	<div class='mt-5 grid gap-3 text-sm'>
		<label class='grid gap-y-1.5 sm:flex sm:items-center sm:gap-3'>
			<span class='opacity-80 sm:w-32 sm:shrink-0'>Upload image</span>
			<input class='ambient-glow-sandbox-upload min-w-0 sm:flex-1' type='file' accept='image/*' />
		</label>

		<button
			type='button'
			class='ambient-glow-sandbox-randomize justify-self-start rounded-md border border-main px-3 py-1.5 font-medium opacity-90 transition-opacity hover:opacity-100 sm:self-start'
		>
			🎲 {t('glow.randomize')}
		</button>

		<!-- curated controls -->
		<div class='ambient-glow-sandbox-controls grid gap-x-2 sm:gap-y-2'>
			<!-- populated via data-* attributes; see <script> below -->
		</div>

		<button
			type='button'
			class='ambient-glow-sandbox-toggle-advanced mt-2 self-start text-xs underline opacity-70 hover:opacity-100'
			aria-expanded='false'
		>
			Show advanced options
		</button>
		<div class='ambient-glow-sandbox-advanced hidden grid gap-x-2 sm:gap-y-2'>
			<!-- populated via data-* attributes; see <script> below -->
		</div>
	</div>
</figure>

<script>
	import { bandForRank, mount, type GlowHandle, type GlowOptions } from '../lib/ambient-glow'
	import type { PulseFrame } from '../lib/audio-pulse'
	import { createPulseDriver, type PulseDriver } from '../lib/glow-pulse-driver'
	import {
		getRadioPlayer,
		type AnalysisFailure,
		type RadioPlayer,
		type RadioState,
	} from '../lib/radio-player'

	const RADIO_API = import.meta.env.PUBLIC_RADIO_API_URL

	type ControlKey = keyof GlowOptions

	interface SliderSpec {
		key: ControlKey
		label: string
		min: number
		max: number
		step: number
		default: number
	}

	interface BoolSpec {
		key: ControlKey
		label: string
		default: boolean
	}

	const CURATED: SliderSpec[] = [
		{ key: 'blur', label: 'Blur', min: 0, max: 120, step: 1, default: 40 },
		{ key: 'sizeMultiplier', label: 'Size multiplier', min: 1, max: 3, step: 0.05, default: 1.5 },
		{ key: 'majorBlobRadius', label: 'Major blob radius', min: 5, max: 60, step: 1, default: 28 },
		{ key: 'gridSize', label: 'Grid size', min: 2, max: 8, step: 1, default: 4 },
		{ key: 'binSize', label: 'Color bin size', min: 4, max: 128, step: 4, default: 32 },
	]

	const ADVANCED_SLIDERS: SliderSpec[] = [
		{ key: 'majorBlobCount', label: 'Major blob count', min: 1, max: 12, step: 1, default: 5 },
		{ key: 'majorBlobOpacity', label: 'Major blob opacity', min: 0, max: 1, step: 0.01, default: 0.78 },
		{ key: 'jitter', label: 'Jitter', min: 0, max: 50, step: 1, default: 18 },
		{ key: 'horizontalStretch', label: 'Horizontal stretch', min: 0.5, max: 2.5, step: 0.05, default: 1.35 },
		{ key: 'verticalStretch', label: 'Vertical stretch', min: 0.5, max: 2.5, step: 0.05, default: 1.1 },
		{ key: 'fadeMs', label: 'Fade (ms)', min: 0, max: 3000, step: 50, default: 1000 },
		{ key: 'blackThreshold', label: 'Black threshold', min: 0, max: 100, step: 1, default: 20 },
		{ key: 'whiteThreshold', label: 'White threshold', min: 150, max: 255, step: 1, default: 235 },
		{ key: 'majorBlobFeather', label: 'Major blob feather', min: 20, max: 100, step: 1, default: 66 },
		{ key: 'edgeBleed', label: 'Edge bleed', min: 0, max: 50, step: 1, default: 22 },
		{ key: 'sideBloomCount', label: 'Side bloom count', min: 0, max: 6, step: 1, default: 2 },
		{ key: 'sideBloomOpacity', label: 'Side bloom opacity', min: 0, max: 1, step: 0.01, default: 0.32 },
		{ key: 'sideBloomRadius', label: 'Side bloom radius', min: 10, max: 80, step: 1, default: 42 },
	]

	const ADVANCED_BOOLS: BoolSpec[] = [
		{ key: 'skipTransparent', label: 'Skip transparent pixels', default: true },
		{ key: 'skipBlack', label: 'Skip near-black pixels', default: true },
		{ key: 'skipWhite', label: 'Skip near-white pixels', default: true },
	]

	const PULSE_AMOUNT: SliderSpec = {
		key: 'pulseAmount',
		label: 'Pulse amount',
		min: 0,
		max: 2,
		step: 0.05,
		default: 1,
	}

	const SPEC_BY_KEY = new Map<ControlKey, SliderSpec>(
		[...CURATED, ...ADVANCED_SLIDERS].map(spec => [spec.key, spec]),
	)

	// Snap a uniformly random value to the slider's step so the output reads cleanly.
	function randomSliderValue(spec: SliderSpec): number {
		const steps = Math.round((spec.max - spec.min) / spec.step)
		const value = spec.min + Math.floor(Math.random() * (steps + 1)) * spec.step
		return parseFloat(Math.min(spec.max, value).toFixed(4))
	}

	function buildSliderRow(spec: SliderSpec): HTMLElement {
		const row = document.createElement('label')
		row.className = 'grid grid-cols-[1fr_auto] items-center gap-x-3 sm:flex sm:items-center'
		const pct = spec.max > spec.min ? ((spec.default - spec.min) / (spec.max - spec.min)) * 100 : 50
		row.innerHTML = `
			<span class="opacity-80 sm:w-32 sm:shrink-0">${spec.label}</span>
			<output class="text-right tabular-nums opacity-70 sm:order-last sm:w-14">${spec.default}</output>
			<input class="demo-slider col-span-2 min-w-0 sm:col-span-1 sm:flex-1" style="--demo-slider-pct: ${pct}%" type="range" min="${spec.min}" max="${spec.max}" step="${spec.step}" value="${spec.default}" data-key="${spec.key}" />
		`
		return row
	}

	function buildBoolRow(spec: BoolSpec): HTMLElement {
		const row = document.createElement('label')
		row.className = 'flex items-center gap-3'
		row.innerHTML = `
			<span class="w-32 shrink-0 opacity-80">${spec.label}</span>
			<input type="checkbox" data-key="${spec.key}" ${spec.default ? 'checked' : ''} />
		`
		return row
	}

	/**
	 * Wires one sandbox to the radio: the explicit pulse button (the only thing
	 * allowed to tap the audio, see RadioPlayer.enableAnalysis), the rAF loop
	 * feeding glow.setPulse(), and the mini spectrum. Returns a cleanup.
	 */
	interface PulseBinding {
		/** Call when the pulse amount changes: 0 stops all motion, >0 restarts it. */
		refresh: () => void
		cleanup: () => void
	}

	function bindPulse(
		root: HTMLElement,
		glow: GlowHandle,
		player: RadioPlayer,
		getAmount: () => number,
		signal: AbortSignal,
	): PulseBinding {
		const labels = root.dataset
		const toggle = root.querySelector<HTMLButtonElement>('.ambient-glow-sandbox-pulse-toggle')!
		const status = root.querySelector<HTMLElement>('.ambient-glow-sandbox-pulse-status')!
		const canvas = root.querySelector<HTMLCanvasElement>('.ambient-glow-sandbox-spectrum')!
		const canvasCtx = canvas.getContext('2d')

		let state: RadioState = player.getState()
		let connecting = false
		// Known up front on Safari/iOS: never offer a click that can't work (and
		// would only start the radio).
		let failure: AnalysisFailure | null = player.getAnalyser() || player.canAnalyse() ? null : 'unsupported'
		// Per band: the colour of the blob it drives, or null if no blob follows it.
		let barColors: Array<string | null> = []
		let textColor = ''
		let framesSinceColors = Infinity

		// Assigned below; player.subscribe() inside createPulseDriver calls onState
		// synchronously, before the assignment, so render() must tolerate its absence.
		let driver: PulseDriver | null = null
		const tapped = () => driver?.hasAnalyser() ?? false

		const render = () => {
			// Only "blocked" is worth retrying; unsupported/failed won't change on a new click.
			toggle.disabled = connecting || failure === 'unsupported' || failure === 'failed'
			if (!tapped()) {
				toggle.textContent = labels.labelEnable ?? ''
				if (connecting) status.textContent = labels.labelConnecting ?? ''
				else if (failure === 'blocked') status.textContent = labels.labelBlocked ?? ''
				else if (failure) status.textContent = labels.labelUnsupported ?? ''
				else status.textContent = ''
				canvas.classList.add('hidden')
				return
			}
			canvas.classList.toggle('hidden', getAmount() === 0)
			toggle.textContent = (state.wantPlaying ? labels.labelPause : labels.labelPlay) ?? ''
			if (state.playing && getAmount() === 0) {
				status.textContent = labels.labelOff ?? ''
			} else if (state.playing && state.track) {
				const who = [state.track.title, state.track.artist].filter(Boolean).join(' — ')
				status.textContent = `${labels.labelPulsingTo ?? ''} ${who}`
			} else if (state.wantPlaying) {
				status.textContent = labels.labelConnecting ?? ''
			} else {
				status.textContent = labels.labelPaused ?? ''
			}
		}

		const refreshColors = (bandCount: number) => {
			const majors = glow.getBlobs().filter(blob => blob.kind === 'major')
			barColors = new Array<string | null>(bandCount).fill(null)
			majors.forEach(({ rank, color }) => {
				barColors[bandForRank(rank, majors.length, bandCount)] = `rgb(${color.r},${color.g},${color.b})`
			})
			textColor = getComputedStyle(canvas).color
		}

		const drawSpectrum = (frame: PulseFrame) => {
			if (!canvasCtx) return
			const dpr = window.devicePixelRatio || 1
			const w = Math.round(canvas.clientWidth * dpr)
			const h = Math.round(canvas.clientHeight * dpr)
			if (!w || !h) return
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w
				canvas.height = h
			}
			// Colours only change with the image/options/theme; refresh twice a second.
			if (framesSinceColors++ > 30) {
				framesSinceColors = 0
				refreshColors(frame.bands.length)
			}
			canvasCtx.clearRect(0, 0, w, h)
			const gap = 4 * dpr
			const barW = (w - gap * (frame.bands.length - 1)) / frame.bands.length
			frame.bands.forEach((value, i) => {
				const barH = Math.max(2 * dpr, value * h)
				const color = barColors[i]
				// Bands no blob listens to are drawn neutral and faint.
				canvasCtx.fillStyle = color ?? textColor
				canvasCtx.globalAlpha = color ? 0.35 + 0.65 * value : 0.15 + 0.25 * value
				canvasCtx.fillRect(i * (barW + gap), h - barH, barW, barH)
			})
			// Loudness as a thin line across, beats as a flash of it.
			canvasCtx.globalAlpha = 0.4 + 0.6 * frame.beat
			canvasCtx.fillStyle = textColor
			canvasCtx.fillRect(0, h - frame.level * h, w, Math.max(1, dpr * (1 + 2 * frame.beat)))
			canvasCtx.globalAlpha = 1
		}

		const pulseDriver = createPulseDriver({
			glow,
			player,
			observe: root,
			getAmount,
			onFrame: drawSpectrum,
			onState: next => {
				state = next
				render()
			},
		})

		toggle.addEventListener(
			'click',
			() => {
				if (tapped()) {
					player.toggle()
					return
				}
				if (failure === 'unsupported' || failure === 'failed') return
				connecting = true
				failure = null
				const pending = pulseDriver.requestTap()
				render()
				void pending.then(result => {
					connecting = false
					if (signal.aborted) return
					if (!result.ok) failure = result.reason
					render()
				})
			},
			{ signal },
		)

		driver = pulseDriver
		render()

		return {
			refresh: () => {
				render()
				pulseDriver.refresh()
			},
			cleanup: () => pulseDriver.destroy(),
		}
	}

	document.addEventListener('astro:page-load', () => {
		const roots = document.querySelectorAll<HTMLElement>('.ambient-glow-sandbox')
		if (roots.length === 0) return

		const cleanups: Array<() => void> = []

		roots.forEach(root => {
			const img = root.querySelector<HTMLImageElement>('.ambient-glow-sandbox-img')!
			const upload = root.querySelector<HTMLInputElement>('.ambient-glow-sandbox-upload')!
			const curatedHost = root.querySelector<HTMLElement>('.ambient-glow-sandbox-controls')!
			const advancedHost = root.querySelector<HTMLElement>('.ambient-glow-sandbox-advanced')!
			const advancedToggle = root.querySelector<HTMLButtonElement>('.ambient-glow-sandbox-toggle-advanced')!
			const randomize = root.querySelector<HTMLButtonElement>('.ambient-glow-sandbox-randomize')!
			// Covers discovered at build time from public/lofi-radio/glow-demo/ (see frontmatter).
			const demoImages = JSON.parse(root.dataset.demoImages || '[]') as string[]
			const pulseHost = root.querySelector<HTMLElement>('.ambient-glow-sandbox-pulse-controls')!
			const audio = document.getElementById('radio-audio') as HTMLAudioElement | null

			// Motion-sensitive readers start with a static glow; the slider can opt in.
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
			const pulseSpec: SliderSpec = {
				...PULSE_AMOUNT,
				label: root.dataset.labelAmount || PULSE_AMOUNT.label,
				default: reducedMotion ? 0 : PULSE_AMOUNT.default,
			}
			let pulseAmount = pulseSpec.default
			let pulseBinding: PulseBinding | null = null

			CURATED.forEach(spec => curatedHost.appendChild(buildSliderRow(spec)))
			if (audio) pulseHost.appendChild(buildSliderRow(pulseSpec))
			else root.querySelector('.ambient-glow-sandbox-pulse')?.remove()
			ADVANCED_SLIDERS.forEach(spec => advancedHost.appendChild(buildSliderRow(spec)))
			ADVANCED_BOOLS.forEach(spec => advancedHost.appendChild(buildBoolRow(spec)))

			const glow = mount(img, { pulseAmount })

			const controller = new AbortController()
			const { signal } = controller

			const FADE_OVERRIDE_MS = 60
			let userFadeMs = ADVANCED_SLIDERS.find(s => s.key === 'fadeMs')?.default ?? 1000

			let pendingPatch: Partial<GlowOptions> = {}
			const pendingDisplays = new Map<HTMLElement, string>()
			let pendingFrame: number | null = null

			const flush = () => {
				pendingFrame = null
				pendingDisplays.forEach((text, el) => {
					el.textContent = text
				})
				pendingDisplays.clear()
				if (Object.keys(pendingPatch).length > 0) {
					glow.setOptions(pendingPatch)
					pendingPatch = {}
				}
			}

			const schedule = () => {
				if (pendingFrame !== null) return
				pendingFrame = requestAnimationFrame(flush)
			}

			root.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(input => {
				const output = input.parentElement?.querySelector('output') as HTMLElement | null
				const key = input.dataset.key as ControlKey
				input.addEventListener(
					'input',
					() => {
						const value = parseFloat(input.value)
						if (output) pendingDisplays.set(output, Number.isInteger(value) ? `${value}` : value.toFixed(2))
						const patch = pendingPatch as Record<string, number | boolean>
						patch[key] = value
						if (key === 'pulseAmount') {
							// Scales per-frame motion only; no fade override, no rebuild.
							pulseAmount = value
							pulseBinding?.refresh()
						} else if (key === 'fadeMs') {
							userFadeMs = value
						} else {
							patch.fadeMs = FADE_OVERRIDE_MS
						}
						schedule()
					},
					{ signal },
				)
				input.addEventListener(
					'change',
					() => {
						if (key === 'fadeMs' || key === 'pulseAmount') return
						;(pendingPatch as Record<string, number | boolean>).fadeMs = userFadeMs
						schedule()
					},
					{ signal },
				)
			})

			root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(input => {
				input.addEventListener(
					'change',
					() => {
						;(pendingPatch as Record<string, number | boolean>)[input.dataset.key as ControlKey] =
							input.checked
						schedule()
					},
					{ signal },
				)
			})

			advancedToggle.addEventListener(
				'click',
				() => {
					const hidden = advancedHost.classList.toggle('hidden')
					advancedToggle.setAttribute('aria-expanded', String(!hidden))
					advancedToggle.textContent = hidden ? 'Show advanced options' : 'Hide advanced options'
				},
				{ signal },
			)

			let lastObjectUrl: string | null = null
			upload.addEventListener(
				'change',
				() => {
					const file = upload.files?.[0]
					if (!file) return
					if (lastObjectUrl) URL.revokeObjectURL(lastObjectUrl)
					lastObjectUrl = URL.createObjectURL(file)
					img.removeAttribute('crossorigin')
					img.src = lastObjectUrl
				},
				{ signal },
			)

			randomize.addEventListener(
				'click',
				() => {
					// Only the simple panel's sliders are randomized — the advanced controls
					// are left untouched. Drive the existing input/change listeners so the
					// output labels, slider fill, fadeMs override and glow update through one path.
					curatedHost.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(input => {
						const spec = SPEC_BY_KEY.get(input.dataset.key as ControlKey)
						if (!spec) return
						input.value = String(randomSliderValue(spec))
						input.dispatchEvent(new Event('input', { bubbles: true }))
						input.dispatchEvent(new Event('change', { bubbles: true }))
					})

					// Switch to a different demo cover (skip the one already showing).
					const choices = demoImages.filter(src => !img.src.endsWith(src))
					const pool = choices.length ? choices : demoImages
					const next = pool[Math.floor(Math.random() * pool.length)]
					if (next) {
						if (lastObjectUrl) {
							URL.revokeObjectURL(lastObjectUrl)
							lastObjectUrl = null
						}
						img.setAttribute('crossorigin', 'anonymous')
						img.src = next
					}
				},
				{ signal },
			)

			pulseBinding = audio
				? bindPulse(root, glow, getRadioPlayer(audio, RADIO_API), () => pulseAmount, signal)
				: null

			cleanups.push(() => {
				pulseBinding?.cleanup()
				controller.abort()
				if (pendingFrame !== null) cancelAnimationFrame(pendingFrame)
				glow.destroy()
				if (lastObjectUrl) URL.revokeObjectURL(lastObjectUrl)
			})
		})

		document.addEventListener(
			'astro:before-preparation',
			() => {
				cleanups.forEach(fn => fn())
			},
			{ once: true },
		)
	})
</script>
